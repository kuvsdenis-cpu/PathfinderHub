rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function userClubIds() {
      return userDoc().clubIds != null && userDoc().clubIds.size() > 0
        ? userDoc().clubIds
        : [userDoc().clubId];
    }

    function userConferenceId() {
      return userDoc().conferenceId;
    }

    // ---------- Роли ----------
    function isConferenceAdmin() {
      return isSignedIn() && userRole() == 'conference_admin';
    }
    function isConferenceSecretary() {
      return isSignedIn() && userRole() == 'conference_secretary';
    }
    function isDirector() {
      return isSignedIn() && userRole() == 'director';
    }
    function isSecretary() {
      return isSignedIn() && userRole() == 'secretary';
    }
    function isInstructor() {
      return isSignedIn() && userRole() == 'instructor';
    }
    function isTeen() {
      return isSignedIn() && userRole() == 'teen';
    }
    function isParent() {
      return isSignedIn() && userRole() == 'parent';
    }

    // ---------- Права director'а ----------
    function isOwner() {
      return isSignedIn()
        && userRole() == 'director'
        && userDoc().isOwnerClub != false;
    }

    function hasPerm(perm) {
      return isConferenceAdmin()
        || isOwner()
        || (isSignedIn()
            && userRole() == 'director'
            && userDoc().directorPermissions != null
            && perm in userDoc().directorPermissions);
    }

    // hasPerm + secretary (по матрице: одинаковые права на модерацию и отчёты).
    function hasPermOrStaff(perm) {
      return hasPerm(perm)
        || (isSignedIn() && userRole() in ['instructor', 'secretary']);
    }

    // ---------- Проверки принадлежности ----------
    function isOwnClub(clubId) {
      return isSignedIn() && clubId in userClubIds();
    }

    function isStaffOfClub(clubId) {
      return isSignedIn()
        && (isDirector() || isSecretary() || isInstructor())
        && isOwnClub(clubId);
    }

    // Может создавать групповые чаты (по матрице: director + instructor, БЕЗ secretary).
    function canCreateGroupChat(clubId) {
      return isSignedIn()
        && (isDirector() || isInstructor())
        && isOwnClub(clubId);
    }

    // ============================================================
    // USERS
    // ============================================================
    match /users/{userId} {

      allow read: if isSignedIn() && (
        uid() == userId
        || isConferenceAdmin()
        || (isConferenceSecretary() && resource.data.conferenceId == userConferenceId())
        || isStaffOfClub(resource.data.clubId)
      );

      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.id == userId;

      // Белый список: что пользователь может менять у себя.
      // Поля взяты из UserEntity.kt.
      allow update: if isSignedIn() && (
        // Сам пользователь — только безопасные поля.
        (uid() == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'id', 'email',
                'firstName', 'lastName', 'avatar', 'birthDate',
                'parentEmail', 'onboardingCompleted',
                'lastLoginAt', 'syncedAt',
                'clubId', 'clubIds',
                'emailVerified', 'accessLevel', 'status',
                'deletionRequestedBy', 'deletionRequestedAt',
                'anonymizedAt', 'permanentDeletionAt',
                'parentalConsentStatus', 'parentalConsentRequestedAt',
                'parentalConsentApprovedAt',
                'createdAt',
                // Поля, которые SyncWorker отправляет целиком через set().
                // Разрешено ИХ ПРИСУТСТВИЕ в diff, но запрещено МЕНЯТЬ значения.
                'role', 'isOwnerClub', 'directorPermissions', 'conferenceId'
              ])
          // Защита: значения этих полей должны совпадать с серверными.
          && request.resource.data.role == resource.data.role
          && request.resource.data.isOwnerClub == resource.data.isOwnerClub
          && request.resource.data.directorPermissions == resource.data.directorPermissions
          && request.resource.data.conferenceId == resource.data.conferenceId)
        // Owner снимает с себя владение (передача клуба): только isOwnerClub/clubIds/clubId.
        || (uid() == userId
            && resource.data.isOwnerClub == true
            && request.resource.data.isOwnerClub == false
            && request.resource.data.role == resource.data.role
            && request.resource.data.directorPermissions == resource.data.directorPermissions
            && request.resource.data.conferenceId == resource.data.conferenceId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isOwnerClub', 'clubIds', 'clubId',
                          'syncedAt', 'lastLoginAt']))
        // Owner назначает нового владельца (передача клуба).
        || (isOwner()
            && isOwnClub(resource.data.clubId)
            && resource.data.isOwnerClub == false
            && request.resource.data.isOwnerClub == true
            && request.resource.data.role == 'director'
            && resource.data.clubId == request.resource.data.clubId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['role', 'isOwnerClub', 'clubIds', 'clubId', 'syncedAt']))
        || isConferenceAdmin()
        // Director со staff-правом: может менять role участника
        // (кроме director) + безопасные поля. НЕ может менять клуб,
        // conferenceId, accessLevel, isOwnerClub, directorPermissions.
        || (hasPerm("members.edit")
            && isOwnClub(resource.data.clubId)
            && resource.data.role != 'director'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['firstName', 'lastName', 'avatar', 'birthDate',
                          'parentEmail', 'onboardingCompleted',
                          'status', 'accessLevel', 'role',
                          'lastLoginAt', 'syncedAt'])
            && request.resource.data.role in ['teen', 'parent', 'instructor', 'secretary'])
      );

      allow delete: if isConferenceAdmin();

      // ---------- Вложенные коллекции ----------
      match /levelProgress/{progressId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /honorProgress/{progressId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /levelCompletions/{completionId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /honorCompletions/{completionId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /notificationPreferences/{prefId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /session/{docId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /certificates/{certId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /testAttempts/{attemptId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId || isConferenceAdmin()
        );
        allow delete: if isConferenceAdmin();
      }
      match /openAnswerReviews/{reviewId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create: if isSignedIn() && uid() == userId;
        allow update: if isSignedIn() && (
          isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /bookReports/{reportId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
      match /verseProgress/{progressId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }

      // ---------- BIBLE MODULE (B5) ----------
      // Приватные данные пользователя. Только владелец.
      // Даже наставник НЕ видит закладки/жемчужины/прогресс чтения.
      match /bibleBookmarks/{verseId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /pearlProgress/{pearlId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /readingPlanProgress/{dayId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /leaderChecklists/{checklistId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || isStaffOfClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
        allow create, update: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (hasPermOrStaff("learning.approve")
              && isOwnClub(get(/databases/$(database)/documents/users/$(userId)).data.clubId))
        );
        allow delete: if isConferenceAdmin();
      }
    }

    // ============================================================
    // PARENT-CHILD LINKS
    // ============================================================
    match /parentChildLinks/{linkId} {
      allow read: if isSignedIn() && (
        resource.data.parentId == uid()
        || resource.data.childId == uid()
        || isConferenceAdmin()
        || isStaffOfClub(resource.data.clubId)
      );
      allow create, update: if isSignedIn() && (
        isConferenceAdmin()
        || (hasPerm("members.edit") && isOwnClub(request.resource.data.clubId))
      );
      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // CLUBS
    // ============================================================
    match /clubs/{clubId} {
      allow read: if isSignedIn();

      // Клуб может создать:
      //   - conference_admin (глобально);
      //   - director (создатель клуба) — с проверкой, что updatedBy == uid().
      // Проверка updatedBy защищает от создания «от имени» другого.
      allow create: if isSignedIn()
        && request.resource.data.id == clubId
        && request.resource.data.updatedBy == uid()
        && (isDirector() || isConferenceAdmin());

      allow update: if isConferenceAdmin()
        || (hasPerm("settings.edit") && isOwnClub(clubId))
        // Owner может soft-delete / restore клуб: только служебные поля.
        || (isSignedIn()
            && isOwner()
            && isOwnClub(clubId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deletedAt', 'deletedBy', 'purgeAt',
                          'updatedAt', 'updatedBy', 'syncedAt']));
      allow delete: if isConferenceAdmin();

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("events.create") && isOwnClub(clubId))
        );
        allow delete: if isConferenceAdmin()
          || (hasPerm("events.delete") && isOwnClub(clubId));

        match /occurrences/{occurrenceId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && (
            isConferenceAdmin() || (hasPerm("events.create") && isOwnClub(clubId))
          );
        }
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn() && isStaffOfClub(clubId);
        allow create, update, delete: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("tasks.create") && isOwnClub(clubId))
        );
      }

      match /assignments/{assignmentId} {
        allow read: if isSignedIn() && (
          resource.data.assignedTo == uid()
          || isStaffOfClub(clubId)
          || isConferenceAdmin()
        );
        allow create, update, delete: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("tasks.create") && isOwnClub(clubId))
        );
      }

      // ---------- TESTS (клубные тесты) ----------
      // Глобальные тесты — из tests.json, в Firestore не пишутся.
      // Здесь — только клубные (clubId != null), созданные редактором.
      // По брифу: тесты создают director + co-director + instructor.
      // secretary — НЕ создаёт.
      match /tests/{testId} {
        allow read: if isSignedIn() && isOwnClub(clubId);
        allow create, update, delete: if isSignedIn() && isOwnClub(clubId) && (
          hasPerm("content.edit") || isInstructor()
        );

        // ---------- Вопросы теста ----------
        match /questions/{questionId} {
          allow read: if isSignedIn() && isOwnClub(clubId);
          allow create, update, delete: if isSignedIn() && isOwnClub(clubId) && (
            hasPerm("content.edit") || isInstructor()
          );
        }
      }

      // ---------- COMMENTS (чат клуба) ----------
      match /comments/{commentId} {
        // Автор видит свой комментарий в любом статусе (с пометкой).
        // Остальные — только published.
        allow read: if isSignedIn() && (
          resource == null
          || isConferenceAdmin()
          || isStaffOfClub(clubId)
          || (resource.data.authorId == uid() && isOwnClub(clubId))
          || (isOwnClub(clubId) && resource.data.status == 'published')
        );

        allow create: if isSignedIn()
          && isOwnClub(clubId)
          && request.resource.data.authorId == uid()
          && request.resource.data.clubId == clubId
          // parent НЕ пишет в клубный чат (по матрице).
          && (isTeen() || isDirector() || isInstructor()
              || isSecretary() || isConferenceAdmin());

        allow update: if isSignedIn() && (
          isConferenceAdmin()
          || (hasPermOrStaff("moderation.review") && isOwnClub(clubId))
          || (resource.data.authorId == uid()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'pendingSync', 'moderatedBy', 'moderatedAt',
                            'hiddenReasonCode', 'hiddenReasonNote']))
        );

        allow delete: if isConferenceAdmin()
          || (hasPerm("moderation.review") && isOwnClub(clubId));
      }

      match /moderationRequests/{reqId} {
        allow read, write: if isSignedIn()
          && (isConferenceAdmin() || (hasPermOrStaff("moderation.review") && isOwnClub(clubId)));
      }
      match /moderationHistory/{historyId} {
        allow read, create: if isSignedIn()
          && (isConferenceAdmin() || (hasPermOrStaff("moderation.review") && isOwnClub(clubId)));
        allow update, delete: if false;
      }
      match /appeals/{appealId} {
        allow read: if isSignedIn() && (
          isConferenceAdmin()
          || resource.data.authorId == uid()
          || (hasPermOrStaff("moderation.review") && isOwnClub(clubId))
        );
        allow create: if isSignedIn()
          && isOwnClub(clubId)
          && request.resource.data.authorId == uid()
          && request.resource.data.clubId == clubId;
        allow update: if isSignedIn()
          && (isConferenceAdmin() || (hasPermOrStaff("moderation.review") && isOwnClub(clubId)));
        allow delete: if isConferenceAdmin();
      }
      match /honorDrafts/{draftId} {
        allow read, write: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("content.edit") && isOwnClub(clubId))
        );
      }

      // ---------- REQUIREMENTS ----------
      match /requirements/{requirementId} {
        match /materials/{materialId} {
          allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());

          allow create, update, delete: if isSignedIn() && (
            isConferenceAdmin() || (hasPerm("content.edit") && isOwnClub(clubId))
          );

          // Наставник / секретарь может только флаг поставить.
          allow update: if isSignedIn()
            && isStaffOfClub(clubId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['flaggedForEdit', 'flaggedBy', 'flaggedAt', 'flagComment']);
        }

        match /tasks/{taskId} {
          allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());

          allow create, update, delete: if isSignedIn() && (
            isConferenceAdmin() || (hasPerm("content.edit") && isOwnClub(clubId))
          );

          allow update: if isSignedIn()
            && isStaffOfClub(clubId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['flaggedForEdit', 'flaggedBy', 'flaggedAt', 'flagComment']);
        }
      }

      // ---------- REQUIREMENT TASK ANSWERS ----------
      match /requirementTaskAnswers/{answerId} {
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || isConferenceAdmin()
          || isStaffOfClub(clubId)
        );

        allow create: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId
          && isOwnClub(clubId);

        // Автор: только свой, только draft/rejected → draft/submitted.
        // Staff: только review-поля.
        allow update: if isSignedIn() && (
          (resource.data.userId == uid()
            && request.resource.data.userId == uid()
            && resource.data.status in ['draft', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['answer', 'attachments', 'status', 'submittedAt',
                          'updatedAt', 'pendingSync'])
            && request.resource.data.status in ['draft', 'submitted'])
          || (isStaffOfClub(clubId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewComment',
                            'autoChecked', 'updatedAt', 'pendingSync'])
              && request.resource.data.status in ['approved', 'rejected', 'auto_approved'])
          || isConferenceAdmin()
        );

        allow delete: if isConferenceAdmin();
      }

      // ---------- QR / CHALLENGES ----------
      match /challenges/{challengeId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update, delete: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("challenges.create") && isOwnClub(clubId))
        );
      }
      match /challengeProgress/{progressId} {
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || isStaffOfClub(clubId)
          || isConferenceAdmin()
        );
        allow create, update: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId
          && isOwnClub(clubId);
        allow delete: if false;
      }
      match /qrQuests/{questId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("qr.create") && isOwnClub(clubId))
        );
        allow delete: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("qr.delete") && isOwnClub(clubId))
        );
      }
      match /qrQuestStations/{linkId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("qr.create") && isOwnClub(clubId))
        );
        allow delete: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("qr.delete") && isOwnClub(clubId))
        );
      }
      match /qrQuestProgress/{progressId} {
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || isStaffOfClub(clubId)
          || isConferenceAdmin()
        );
        allow create, update: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId
          && isOwnClub(clubId);
        allow delete: if false;
      }
      match /qrStations/{stationId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("qr.create") && isOwnClub(clubId))
        );
        allow delete: if isSignedIn() && (
          isConferenceAdmin() || (hasPerm("qr.delete") && isOwnClub(clubId))
        );
      }
      match /stationVisits/{visitId} {
        allow read: if isSignedIn() && (isStaffOfClub(clubId) || isConferenceAdmin());
        allow create: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId
          && isOwnClub(clubId);
        allow update, delete: if false;
      }

      // ---------- CROSS-CLUB ----------
      match /crossClubInvites/{id} {
        allow read: if isSignedIn() && (
          resource.data.hostClubId in userClubIds()
          || resource.data.inviteeClubId in userClubIds()
          || isConferenceAdmin()
        );
        allow create: if isSignedIn() && (
          (isDirector() && isOwnClub(request.resource.data.hostClubId))
          || (isTeen() && isOwnClub(request.resource.data.hostClubId)
              && request.resource.data.createdBy == uid())
        );
        allow update: if isSignedIn() && (
          resource.data.hostClubId in userClubIds()
          || resource.data.inviteeClubId in userClubIds()
          || isConferenceAdmin()
        );
        allow delete: if isSignedIn() && (
          isConferenceAdmin() || resource.data.hostClubId in userClubIds()
        );
      }
      match /crossClubInviteCodes/{id} {
        allow read: if isSignedIn() && (
          resource.data.createdBy == uid()
          || resource.data.hostClubId in userClubIds()
          || isConferenceAdmin()
        );
        allow create: if isSignedIn()
          && request.resource.data.createdBy == uid()
          && isOwnClub(request.resource.data.hostClubId);
        allow update: if isSignedIn() && (
          resource.data.createdBy == uid()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']))
          || isConferenceAdmin()
        );
        allow delete: if isSignedIn() && (
          isConferenceAdmin() || resource.data.createdBy == uid()
        );
      }
      match /crossClubInviteUsages/{id} {
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || resource.data.userClubId in userClubIds()
          || isConferenceAdmin()
        );
        allow create: if isSignedIn()
          && request.resource.data.userId == uid();
        allow update, delete: if false;
      }

      // ---------- REPORTS ----------
      match /reports/{reportId} {
        allow read, create, update: if isSignedIn() && (
          isConferenceAdmin() || (hasPermOrStaff("reports.generate") && isOwnClub(clubId))
        );
        allow delete: if isConferenceAdmin();
      }

      // ---------- GROUP CHATS ----------
      match /groupChats/{groupId} {
        allow read: if isSignedIn() && (
          resource == null
          || request.auth.uid in resource.data.participants
          || isConferenceAdmin()
        );
        // По матрице: director + instructor. Secretary — НЕ создаёт.
        allow create: if canCreateGroupChat(clubId)
          && request.resource.data.createdBy == uid()
          && request.resource.data.clubId == clubId;
        allow update: if isSignedIn() && (
          resource.data.createdBy == uid()
          || isConferenceAdmin()
        );
        allow delete: if isSignedIn() && resource.data.createdBy == uid();

        match /messages/{msgId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)/groupChats/$(groupId)).data.participants;
          allow create: if isSignedIn()
            && isOwnClub(clubId)
            && request.resource.data.authorId == uid();
          allow update, delete: if false;
        }
      }

      // ---------- DIRECT MESSAGES ----------
      match /directMessages/{dmId} {
        allow read: if isSignedIn() && (
          resource == null
          || request.auth.uid in resource.data.participants
          || isConferenceAdmin()
        );
        allow create: if isSignedIn()
          && isOwnClub(clubId)
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() == 2
          && request.resource.data.clubId == clubId
          // parent НЕ создаёт DM (по матрице).
          && (isTeen() || isDirector() || isInstructor()
              || isSecretary() || isConferenceAdmin());
        allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants;
        allow delete: if isConferenceAdmin();

        match /messages/{msgId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)/directMessages/$(dmId)).data.participants;
          allow create: if isSignedIn()
            && isOwnClub(clubId)
            && request.resource.data.authorId == uid();
          allow update, delete: if false;
        }
      }
    }

    // ============================================================
    // КОНТЕНТ (глобальный, read-only для всех авторизованных)
    // ============================================================
    match /levels/{levelId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /levelSections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /levelRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honors/{honorId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honorCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honorRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /contentVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /conferences/{confId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == confId);
    }
    match /conferenceMembers/{memberId} {
      allow read: if isSignedIn() && (
        isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == resource.data.conferenceId)
      );
      allow write: if isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == request.resource.data.conferenceId);
    }
    match /conferenceEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == request.resource.data.conferenceId);
      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // ИНВАЙТЫ
    // ============================================================
    match /invites/{code} {
      // Регистрация по инвайту происходит ДО логина:
      // клиент вызывает document(code).get() — значит нужен allow get.
      // Перебор коллекции (list) запрещён.
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && (hasPerm("invites.create") || isConferenceAdmin())
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'active';

      // Клиент использует runTransaction: active↔claiming→used.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedAt', 'usedBy', 'usedAt'])
        && request.resource.data.status in ['active', 'claiming', 'used', 'expired'];

      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // АУДИТ — клиент не пишет напрямую (AuditRepository → Room)
    // ============================================================
    match /auditLog/{logId} {
      allow read: if isSignedIn() && (
        isConferenceAdmin()
        || (isDirector() && resource.data.clubId in userClubIds())
      );
      allow create, update, delete: if false;
    }
    match /securityLog/{logId} {
      allow read: if isConferenceAdmin();
      allow create, update, delete: if false;
    }

    // ============================================================
    // Запрет по умолчанию
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}