rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Вспомогательные функции
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function userClubId() {
      return userDoc().clubId;
    }

    function isConferenceAdmin() {
      return isSignedIn() && userRole() == 'conference_admin';
    }

    function isDirector() {
      return isSignedIn() && userRole() == 'director';
    }

    function isSecretary() {
      return isSignedIn() && userRole() == 'secretary';
    }

    function isInstructor() {
      return isSignedIn() && userRole() == 'instructor';
    }

    function isTeen() {
      return isSignedIn() && userRole() == 'teen';
    }

    function isParent() {
      return isSignedIn() && userRole() == 'parent';
    }

    function isClubStaff() {
      return isSignedIn() && (userRole() in ['director', 'secretary', 'instructor']);
    }

    function isOwnClub(clubId) {
      return isSignedIn() && userClubId() == clubId;
    }
    // ============================================================
    // INVITES — регистрация по инвайт-коду
    // ============================================================
    match /invites/{code} {
      // Чтение: любой может проверить код (даже без авторизации),
      // потому что пользователь ещё не залогинен на этапе регистрации.
      allow read: if true;

      // Создание: staff своего клуба (директор/секретарь/инструктор).
      // createdBy должен совпадать с uid создателя.
      allow create: if isSignedIn()
        && isClubStaff()
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'active';

      // Обновление:
      //   active → claiming (резервирование, любой авторизованный)
      //   claiming → used (подтверждение, любой авторизованный)
      //   claiming → active (откат, любой авторизованный)
      //   active → expired (автоматически при истечении)
      //
      // Запрещаем менять другие поля (id, code, clubId, role, createdBy).
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['status', 'usedBy', 'usedAt', 'claimedAt'])
        && request.resource.data.status in ['claiming', 'used', 'active', 'expired'];

      // Удаление: только conference_admin.
      allow delete: if isConferenceAdmin();
    }
    // ============================================================
    // USERS — Подход B: Firebase Auth uid == document id
    // ============================================================
    match /users/{userId} {
      // Чтение: свой профиль; staff своего клуба — профили участников; conference_admin — все
      allow read: if isSignedIn() && (
        uid() == userId
        || isConferenceAdmin()
        || (isClubStaff() && userDoc().clubId == resource.data.clubId)
      );

      // Создание: только сам пользователь (после registerWithEmail)
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.id == userId;

      // Обновление: свой профиль (ограниченные поля); staff может менять accessLevel/status
      allow update: if isSignedIn() && (
        (uid() == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'clubId', 'conferenceId', 'accessLevel', 'status']))
        || isConferenceAdmin()
        || (isDirector() && isOwnClub(resource.data.clubId))
      );

      // Удаление: только conference_admin
      allow delete: if isConferenceAdmin();

      // ---------- Вложенные коллекции ----------
      match /levelProgress/{progressId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /honorProgress/{progressId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /levelCompletions/{completionId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /honorCompletions/{completionId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /notificationPreferences/{prefId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /testAttempts/{attemptId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /openAnswerReviews/{reviewId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /bookReports/{reportId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /verseProgress/{progressId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /leaderChecklists/{checklistId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
    }

    // ============================================================
    // PARENT-CHILD LINKS
    // ============================================================
    match /parentChildLinks/{linkId} {
      allow read: if isSignedIn() && (
        linkId.matches('.*' + uid() + '.*')
        || isConferenceAdmin()
      );
      allow create, update: if isSignedIn() && isClubStaff();
      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // CLUBS
    // ============================================================
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isConferenceAdmin();
      allow update: if isConferenceAdmin() || (isDirector() && isOwnClub(clubId));
      allow delete: if isConferenceAdmin();

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow delete: if isConferenceAdmin() || (isDirector() && isOwnClub(clubId));

        match /occurrences/{occurrenceId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        }
      }
      match /tasks/{taskId} {
        allow read: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow create: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow update: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow delete: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
      }
      match /assignments/{assignmentId} {
        allow read: if isSignedIn() && (
          resource.data.assignedTo == uid()
          || (isClubStaff() && isOwnClub(clubId))
        );
        allow create, update: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow delete: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
      }
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          isClubStaff() && isOwnClub(clubId)
          || resource.data.authorId == uid()
        );
        allow delete: if isConferenceAdmin() || (isDirector() && isOwnClub(clubId));
      }
      match /moderationRequests/{reqId} {
        allow read, write: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
      }
      match /moderationHistory/{historyId} {
        allow read: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow create: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow update, delete: if false;
      }
      match /appeals/{appealId} {
        allow read, create: if isSignedIn();
        allow update: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow delete: if isConferenceAdmin();
      }
      match /honorDrafts/{draftId} {
        allow read, write: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
      }
      match /reports/{reportId} {
        allow read: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow create: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow update: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow delete: if isConferenceAdmin();
      }
    }

    // ============================================================
    // КОНТЕНТ (read-only для всех авторизованных)
    // ============================================================
    match /levels/{levelId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /levelSections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /levelRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honors/{honorId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honorCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honorRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /contentVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /conferences/{confId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }

    // ============================================================
    // АУДИТ
    // ============================================================
    match /auditLog/{logId} {
      allow read: if isConferenceAdmin() || (isDirector() && resource.data.clubId == userClubId());
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /securityLog/{logId} {
      allow read: if isConferenceAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ============================================================
    // Все остальные пути — запрет по умолчанию
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}