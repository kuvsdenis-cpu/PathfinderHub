          "isAdvanced": false,
          "imageUrls": []
        },
        {
          "id": "friend_general_req_03",
          "sectionId": "general",
          "levelId": "friend",
          "text": "Знать на память и объяснить Обещание и Закон следопытов",
          "type": "boolean",
          "order": 3,
          "isAdvanced": false,
          "imageUrls": []
        },
        {
          "id": "friend_general_req_04",
          "sectionId": "general",
          "levelId": "friend",
          "text": "Прочитать книгу «Путь к победе» или другую рекомендованную книгу об Обещании и Законе следопытов",
          "type": "boolean",
          "order": 4,
          "isAdvanced": false,
          "imageUrls": []
        },
        {
          "id": "friend_general_req_05",
          "sectionId": "general",
          "levelId": "friend",
