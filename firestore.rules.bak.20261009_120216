rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Вспомогательные функции
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function userClubId() {
      return userDoc().clubId;
    }

    // Мульти-клуб: список всех клубов пользователя.
    // Fallback: если clubIds пуст (старый юзер) — [clubId].
    function userClubIds() {
      return userDoc().clubIds != null && userDoc().clubIds.size() > 0
        ? userDoc().clubIds
        : [userDoc().clubId];
    }

    function isConferenceAdmin() {
      return isSignedIn() && userRole() == 'conference_admin';
    }

    function isDirector() {
      return isSignedIn() && userRole() == 'director';
    }

    function isSecretary() {
      return isSignedIn() && userRole() == 'secretary';
    }

    function isInstructor() {
      return isSignedIn() && userRole() == 'instructor';
    }

    function isTeen() {
      return isSignedIn() && userRole() == 'teen';
    }

    function isParent() {
      return isSignedIn() && userRole() == 'parent';
    }

    function isClubStaff() {
      return isSignedIn() && (userRole() in ['director', 'secretary', 'instructor']);
    }

    function isConferenceSecretary() {
      return isSignedIn() && userRole() == 'conference_secretary';
    }

    function userConferenceId() {
      return userDoc().conferenceId;
    }

    function isModerator() {
      return isClubStaff();
    }

    function isOwnClub(clubId) {
      return isSignedIn() && clubId in userClubIds();
    }

    // Владелец клуба: director с флагом isOwnerClub (или старый director без флага).
    function isOwner() {
      return isSignedIn()
        && userRole() == 'director'
        && userDoc().isOwnerClub != false;
    }

    // Владелец, co-director с явным правом, или conference_admin.
    function hasPerm(perm) {
      return isConferenceAdmin()
        || isOwner()
        || (isSignedIn()
            && userRole() == 'director'
            && userDoc().directorPermissions != null
            && perm in userDoc().directorPermissions);
    }

    // hasPerm + instructor/secretary (совместимость с прежним isClubStaff).
    function hasPermOrStaff(perm) {
      return hasPerm(perm)
        || (isSignedIn() && userRole() in ['instructor', 'secretary']);
    }

    // ============================================================
    // USERS — Firebase Auth uid == document id
    // ============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        uid() == userId
        || isConferenceAdmin()
        || (isClubStaff() && userDoc().clubId == resource.data.clubId)
      );

      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.id == userId;

      allow update: if isSignedIn() && (
        (uid() == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'clubId', 'clubIds', 'conferenceId', 'accessLevel', 'status',
                       'isOwnerClub', 'directorPermissions']))
        || isConferenceAdmin()
        || (hasPerm("members.edit") && isOwnClub(resource.data.clubId))
      );

      allow delete: if isConferenceAdmin();

      // ---------- Вложенные коллекции ----------
      match /levelProgress/{progressId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /honorProgress/{progressId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /levelCompletions/{completionId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /honorCompletions/{completionId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /notificationPreferences/{prefId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /session/{docId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /certificates/{certId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && get(/databases/$(database)/documents/users/$(userId)).data.clubId == userClubId())
        );
        allow create, update: if isSignedIn() && uid() == userId;
        allow delete: if isConferenceAdmin();
      }
      match /testAttempts/{attemptId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /openAnswerReviews/{reviewId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /bookReports/{reportId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /verseProgress/{progressId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
      match /leaderChecklists/{checklistId} {
        allow read, write: if isSignedIn() && (
          uid() == userId
          || isConferenceAdmin()
          || (isClubStaff() && userDoc().clubId == get(/databases/$(database)/documents/users/$(userId)).data.clubId)
        );
      }
    }

    // ============================================================
    // PARENT-CHILD LINKS
    // ============================================================
    match /parentChildLinks/{linkId} {
      allow read: if isSignedIn() && (
        linkId.matches('.*' + uid() + '.*')
        || isConferenceAdmin()
      );
      allow create, update: if isSignedIn() && isClubStaff();
      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // CLUBS
    // ============================================================
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isConferenceAdmin();
      allow update: if isConferenceAdmin() || (hasPerm("settings.edit") && isOwnClub(clubId));
      allow delete: if isConferenceAdmin();

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (hasPerm("events.create") && isOwnClub(clubId));
        allow delete: if isConferenceAdmin() || (hasPerm("events.delete") && isOwnClub(clubId));

        match /occurrences/{occurrenceId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        }
      }
      match /tasks/{taskId} {
        allow read: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow create: if isSignedIn() && (hasPerm("tasks.create") && isOwnClub(clubId));
        allow update: if isSignedIn() && (hasPerm("tasks.create") && isOwnClub(clubId));
        allow delete: if isSignedIn() && (hasPerm("tasks.create") && isOwnClub(clubId));
      }
      match /assignments/{assignmentId} {
        allow read: if isSignedIn() && (
          resource.data.assignedTo == uid()
          || (isClubStaff() && isOwnClub(clubId))
        );
        allow create, update: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
        allow delete: if isSignedIn() && (isClubStaff() && isOwnClub(clubId));
      }

      // ============================================================
      // COMMENTS — чат клуба и комментарии к событиям/задачам
      // ============================================================
      match /comments/{commentId} {
        // Чтение: только участники своего клуба или conference_admin.
        // resource == null — на случай подписки на несуществующий документ.
        allow read: if isSignedIn() && (
          resource == null
          || isOwnClub(clubId)
          || isConferenceAdmin()
        );

        // Создание: сам автор, и clubId в документе совпадает с путём.
        allow create: if isSignedIn()
          && request.resource.data.authorId == uid()
          && request.resource.data.clubId == clubId;

        // Обновление: автор может менять только статус/pendingSync (модерация),
        // staff клуба — любые поля (модерация).
        allow update: if isSignedIn() && (
          isConferenceAdmin()
          || (isClubStaff() && isOwnClub(clubId))
          || (resource.data.authorId == uid()
              && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['status', 'pendingSync', 'moderatedBy', 'moderatedAt', 'hiddenReasonCode', 'hiddenReasonNote']))
        );

        allow delete: if isConferenceAdmin() || (hasPerm("moderation.review") && isOwnClub(clubId));
      }

      match /moderationRequests/{reqId} {
        allow read, write: if isSignedIn() && (hasPermOrStaff("moderation.review") && isOwnClub(clubId));
      }
      match /moderationHistory/{historyId} {
        allow read: if isSignedIn() && (hasPermOrStaff("moderation.review") && isOwnClub(clubId));
        allow create: if isSignedIn() && (hasPermOrStaff("moderation.review") && isOwnClub(clubId));
        allow update, delete: if false;
      }
      match /appeals/{appealId} {
        allow read, create: if isSignedIn();
        allow update: if isSignedIn() && (hasPermOrStaff("moderation.review") && isOwnClub(clubId));
        allow delete: if isConferenceAdmin();
      }
      match /honorDrafts/{draftId} {
        allow read, write: if isSignedIn() && (hasPermOrStaff("content.edit") && isOwnClub(clubId));
      }
      // ============================================================
      // REQUIREMENTS — материалы и задания требования (внутри клуба)
      // ============================================================
      match /requirements/{requirementId} {
        // Материалы и задания видны всем участникам клуба.
        match /materials/{materialId} {
          allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
          allow create, update, delete: if isSignedIn() && (
            isConferenceAdmin()
            || (hasPerm("content.edit") && isOwnClub(clubId))
          );
          // Наставник может только флаг поставить (обновление ограниченного набора полей).
          allow update: if isSignedIn() && isClubStaff() && isOwnClub(clubId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['flaggedForEdit', 'flaggedBy', 'flaggedAt', 'flagComment']);
        }

        match /tasks/{taskId} {
          allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
          allow create, update, delete: if isSignedIn() && (
            isConferenceAdmin()
            || (hasPerm("content.edit") && isOwnClub(clubId))
          );
          allow update: if isSignedIn() && isClubStaff() && isOwnClub(clubId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['flaggedForEdit', 'flaggedBy', 'flaggedAt', 'flagComment']);
        }
      }

      // ============================================================
      // ANSWERS — ответы на проверочные задания (плоско, по клубу)
      // ============================================================
      // ============================================================
      // DIRECT MESSAGES — личные чаты (DM)
      // clubs/{clubId}/directMessages/{dmId}/messages/{msgId}
      // dmId = sorted([uidA, uidB]).join("_")
      // ============================================================
      // ============================================================
      // GROUP CHATS — групповые чаты клуба
      // clubs/{clubId}/groupChats/{groupId}/messages/{msgId}
      // ============================================================
      match /groupChats/{groupId} {
        // resource == null — snapshot-listener может подписаться на несуществующий
        // документ (observeGroupMeta до создания). Без этой ветки Firestore
        // отвечает PERMISSION_DENIED, а не not-found.
        allow read: if isSignedIn() && (
          resource == null
          || request.auth.uid in resource.data.participants
          || isConferenceAdmin()
        );
        allow create: if isSignedIn()
          && isOwnClub(clubId)
          && isClubStaff()
          && request.resource.data.createdBy == uid()
          && request.resource.data.clubId == clubId;
        allow update: if isSignedIn() && (
          resource.data.createdBy == uid()
          || isConferenceAdmin()
        );
        allow delete: if isSignedIn() && resource.data.createdBy == uid();

        match /messages/{msgId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)/groupChats/$(groupId)).data.participants;
          allow create: if isSignedIn()
            && isOwnClub(clubId)
            && request.resource.data.authorId == uid();
          allow update, delete: if false;
        }
      }

      match /directMessages/{dmId} {
        // resource == null — getOrCreateDM подписывается до создания документа.
        allow read: if isSignedIn() && (
          resource == null
          || request.auth.uid in resource.data.participants
          || isConferenceAdmin()
        );
        allow create: if isSignedIn()
          && isOwnClub(clubId)
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() == 2
          && request.resource.data.clubId == clubId;
        allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants;
        allow delete: if isConferenceAdmin();

        match /messages/{msgId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)/directMessages/$(dmId)).data.participants;
          allow create: if isSignedIn()
            && isOwnClub(clubId)
            && request.resource.data.authorId == uid();
          allow update, delete: if false;
        }
      }

      match /requirementTaskAnswers/{answerId} {
        // Следопыт читает свои ответы.
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || isConferenceAdmin()
          || (isClubStaff() && isOwnClub(clubId))
        );

        // Следопыт создаёт/обновляет только свой ответ, с userId == uid().
        allow create: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId;

        // Обновление: автор может менять свой ответ (draft/submit).
        // Наставник/директор — менять статус, reviewedBy, reviewedAt, reviewComment.
        allow update: if isSignedIn() && (
          (resource.data.userId == uid()
            && request.resource.data.userId == uid())
          || (hasPermOrStaff("learning.approve") && isOwnClub(clubId))
          || isConferenceAdmin()
        );

        allow delete: if isConferenceAdmin();
      }

      // ============================================================
      // QR-СТАНЦИИ
      // ============================================================
      match /challenges/{challengeId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (hasPerm("challenges.create") && isOwnClub(clubId));
        allow delete: if isSignedIn() && (hasPerm("challenges.create") && isOwnClub(clubId));
      }

      match /challengeProgress/{progressId} {
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || (isClubStaff() && isOwnClub(clubId))
          || isConferenceAdmin()
        );
        allow create, update: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId;
        allow delete: if false;
      }

      match /qrQuests/{questId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (hasPerm("qr.create") && isOwnClub(clubId));
        allow delete: if isSignedIn() && (hasPerm("qr.delete") && isOwnClub(clubId));
      }

      match /qrQuestStations/{linkId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (hasPerm("qr.create") && isOwnClub(clubId));
        allow delete: if isSignedIn() && (hasPerm("qr.delete") && isOwnClub(clubId));
      }

      match /qrQuestProgress/{progressId} {
        allow read: if isSignedIn() && (
          resource.data.userId == uid()
          || (isClubStaff() && isOwnClub(clubId))
          || isConferenceAdmin()
        );
        allow create, update: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId;
        allow delete: if false;
      }

      match /qrStations/{stationId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create, update: if isSignedIn() && (hasPerm("qr.create") && isOwnClub(clubId));
        allow delete: if isSignedIn() && (hasPerm("qr.delete") && isOwnClub(clubId));
      }

      match /stationVisits/{visitId} {
        allow read: if isSignedIn() && (isOwnClub(clubId) || isConferenceAdmin());
        allow create: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.clubId == clubId;
        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isSignedIn() && (hasPermOrStaff("reports.view") && isOwnClub(clubId));
        allow create: if isSignedIn() && (hasPermOrStaff("reports.generate") && isOwnClub(clubId));
        allow update: if isSignedIn() && (hasPermOrStaff("reports.generate") && isOwnClub(clubId));
        allow delete: if isConferenceAdmin();
      }
    }

    // ============================================================
    // КОНТЕНТ (read-only для всех авторизованных)
    // ============================================================
    match /levels/{levelId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /levelSections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /levelRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honors/{honorId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honorCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /honorRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /contentVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin();
    }
    match /conferences/{confId} {
      allow read: if isSignedIn();
      allow write: if isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == confId);
    }

    // ---- Conference members (секретарь конференции) ----
    match /conferenceMembers/{memberId} {
      allow read: if isSignedIn() && (
        isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == resource.data.conferenceId)
      );
      allow write: if isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == request.resource.data.conferenceId);
    }

    // ---- Conference events (мероприятия конференции) ----
    match /conferenceEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isConferenceAdmin()
        || (isConferenceSecretary() && userConferenceId() == request.resource.data.conferenceId);
      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // ИНВАЙТЫ
    // ============================================================
    match /invites/{code} {
      allow read: if true;
      allow create: if isSignedIn()
        && (hasPerm("invites.create") || isConferenceAdmin())
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'active';
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['status', 'usedBy', 'usedAt', 'claimedAt'])
        && request.resource.data.status in ['claiming', 'used', 'active', 'expired'];
      allow delete: if isConferenceAdmin();
    }

    // ============================================================
    // АУДИТ
    // ============================================================
    match /auditLog/{logId} {
      allow read: if isConferenceAdmin() || (isDirector() && resource.data.clubId == userClubId());
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /securityLog/{logId} {
      allow read: if isConferenceAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ============================================================
    // Все остальные пути — запрет по умолчанию
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}