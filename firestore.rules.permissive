rules_version = '2';

// ============================================================
// Pathfinder Hub — PERMISSIVE rules для РАЗРАБОТКИ.
// ⚠️ НЕ ИСПОЛЬЗОВАТЬ В PRODUCTION.
// Любой залогиненный пользователь может читать/писать всё.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}